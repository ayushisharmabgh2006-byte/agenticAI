PORT=4000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Authentication & Encryption Secrets
JWT_SECRET=agentflow-super-secret-jwt-key-32chars
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Optional Database & Queues (defaults to memory store if omitted)
MONGODB_URI=
REDIS_URL=

# Optional AI Providers (defaults to deterministic rule generator if omitted)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# RAG provider: optional; local grounded retrieval works without this key
RAG_LLM_PROVIDER=gemini

# Optional Third-Party OAuth & Webhook Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/integrations/oauth/gmail/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:4000/api/integrations/oauth/discord/callback

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:4000/api/integrations/oauth/google-sheets/callback
